FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .
COPY models/ models/

# Render/Railway inject the port via $PORT; default to 8000 for local docker run
ENV PORT=8000
EXPOSE 8000

# Exec form explicitly invoking a shell guarantees $PORT gets substituted,
# unlike relying on Docker's implicit shell-form parsing (which some platforms
# handle inconsistently). ${PORT:-8000} also falls back to 8000 if PORT is unset.
CMD ["/bin/sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
